diff --git a/resource-overlay/device/SystemUI/res/values/dimens.xml b/resource-overlay/device/SystemUI/res/values/dimens.xml
index 667c4ca..34a737b 100644
--- a/resource-overlay/device/SystemUI/res/values/dimens.xml
+++ b/resource-overlay/device/SystemUI/res/values/dimens.xml
@@ -4,8 +4,18 @@
      SPDX-License-Identifier: Apache-2.0
 -->
 <resources>
-    <!-- the padding on the start of the statusbar -->
-    <dimen name="status_bar_padding_start">8dp</dimen>
+    <!-- Motorola/LineageOS ship 8dp. 25dp = 62px: 5dp tighter than the 30dp used through
+         18.10, which puts the clock (and the QS header, it derives from this) where the user
+         measured it as best. The end side stays at 6dp for the privacy dot. -->
+    <dimen name="status_bar_padding_start">25dp</dimen>
+
+    <!-- 5.6dp = 14px: the value the shipped bronco build measured best against the QS header. -->
+    <dimen name="status_bar_padding_top">5.6dp</dimen>
+
+    <!-- 6dp: enough that the privacy/appops dot clears the battery, small enough that the dot reads
+         as the next icon (dot gap ~6dp). Larger values (14dp) leave a visible hole. -->
+    <dimen name="ongoing_appops_dot_min_padding">14dp</dimen>
+    <dimen name="status_bar_padding_end">6dp</dimen>
 
     <!-- Height of the status bar header bar when on Keyguard -->
     <dimen name="status_bar_header_height_keyguard">@*android:dimen/status_bar_height</dimen>
